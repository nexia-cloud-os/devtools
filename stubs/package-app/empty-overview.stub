import { useTranslation } from "react-i18next";
import { AppRouteFrame, NxEmptyView } from "@nexia/sdk/host";

/** Neutral landing page; published navigation owns the available pages. */
export default function {{ appPrefix }}OverviewSurface() {
    const { t } = useTranslation();

    return (
        <AppRouteFrame
            appKey="{{ appKey }}"
            title={t("{{ appKey }}.overview.title")}
            subtitle={t("{{ appKey }}.overview.subtitle")}
        >
            <NxEmptyView kind="empty" title={t("{{ appKey }}.overview.empty.description")} />
        </AppRouteFrame>
    );
}
