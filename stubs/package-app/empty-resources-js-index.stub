import {
    autoRegisterPackageResourceInspectors,
    autoRegisterPackageSurfaces,
} from '@nexia/sdk/host';

const resourceContractModules = import.meta.glob('./resources/*/*-resource-contract.ts', { eager: true });

autoRegisterPackageResourceInspectors(
    import.meta.glob('./resources/*/inspector/register-*-inspector.ts', { eager: true }),
    resourceContractModules,
);

autoRegisterPackageSurfaces({
    appPrefix: '{{ appPrefix }}',
    appKey: '{{ appKey }}',
    overview: () => import('./overview/{{ appPrefix }}OverviewSurface'),
    surfaces: import.meta.glob('./resources/*/surface/*Surface.tsx'),
    resourceContracts: Object.fromEntries(
        Object.entries(resourceContractModules).map(([path, module]) => [path, async () => module]),
    ),
    overrides: {
        // nexia:pages:end
    },
});
