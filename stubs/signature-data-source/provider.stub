{{ sourceRefAnchorConstant }}

    private const MIN_ITEMS = {{ minItems }};

    private const MAX_ITEMS = {{ maxItems }};{{ stableOrderConstants }}

    private const LOOKUP_TIMEOUT_SECONDS = 5;

    /** @var non-empty-list<string> */
    private const FIELD_KEYS = ['{{ fieldKey }}'{{ manyFieldKey }}];

    public function appKey(): string
    {
        return '{{ appKey }}';
